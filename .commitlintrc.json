{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [2, "always", ["feat", "fix", "docs", "chore", "ci", "test", "refactor", "perf", "build", "style", "revert"]],
    "subject-case": [0],
    "subject-empty": [2, "never"],
    "type-empty": [2, "never"],
    "body-max-line-length": [0],
    "footer-max-line-length": [0]
  }
}
